# Copy to .env next to the jar (or in this folder) and fill in.
# Process environment variables take precedence. No inline comments: values are read verbatim.

# --- Web dashboard database (PostgreSQL on the VPS) ---
PG_URL=jdbc:postgresql://<vps-host>:5432/vyom_erp
PG_USER=vyom
PG_PASSWORD=

# --- Z200BW device ---
# Comm key set on the device (required).
DEVICE_PASSWORD=0
DEVICE_IP=192.168.31.120
DEVICE_PORT=5005
DEVICE_MACHINE=1
# Folder with SBXPCDLL64.dll + SBPCCOMM64.dll (default: native)
# DEVICE_DLL_DIR=native

# Auto-sync period in seconds (min 15).
SYNC_INTERVAL_SECONDS=120
